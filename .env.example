# Copy to .env and edit. Never commit .env.

# --- Database ---
POSTGRES_USER=powerprocurement
POSTGRES_PASSWORD=change-me
POSTGRES_DB=powerprocurement
DATABASE_URL=postgresql+psycopg://powerprocurement:change-me@db:5432/powerprocurement

# --- AI (all model calls go through the adapter in backend/app/ai) ---
# mock = replay recorded responses (default, no key needed); anthropic = live Claude API
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=4096
# Extractions below this confidence go to a human instead of continuing automatically
AI_CONFIDENCE_THRESHOLD=0.75
ANTHROPIC_API_KEY=

# --- Mail ---
# Demo mode: everything goes to Mailpit (http://localhost:8025). Nothing leaves the machine.
MAIL_REAL_SEND_ENABLED=false
MAIL_ALLOWED_RECIPIENTS=
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=procurement@demo.local
